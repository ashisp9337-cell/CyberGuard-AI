# CyberGuard cloud settings TEMPLATE (9 Nov 2026). On the server:
#   cp deploy/cloud.env.example deploy/.env.cloud
#   nano deploy/.env.cloud        <- fill in the values; this copy is ignored by Git and never leaves the server
# Make random values on the server with:   openssl rand -hex 32

# ---- address -----------------------------------------------------------------------------------------------------
# The DNS name of the server's public IP (Azure: Public IP > Configuration > DNS name label)
CG_DOMAIN=yourname.centralindia.cloudapp.azure.com
# Folder on the server with the uploaded models (the whole backend\app\ml\models folder from the laptop)
CG_MODELS_DIR=/home/azureuser/models

# ---- database (only reachable inside the server) ------------------------------------------------------------------
# letters and digits only (it goes into a database address): openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- login security -----------------------------------------------------------------------------------------------
# 64 random characters: openssl rand -hex 32
JWT_SECRET=
# your own e-mail: this account becomes the administrator when you sign up with it
ADMIN_EMAILS=
# Cloudflare Turnstile (free CAPTCHA, required in production): dash.cloudflare.com > Turnstile > Add widget,
# hostname = CG_DOMAIN. The SITE key is public, the SECRET key is private.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- company (optional) ---------------------------------------------------------------------------------------------
# Name shown on the sign-up page and to employees, e.g. THREATORA Pvt Ltd
COMPANY_NAME=
# E-mail domains whose people may join by themselves, e.g. threatora.in (comma-separated). Everyone else - e.g. judges
# with Gmail - needs an invite from an administrator (Employees page). EMPTY = anyone may sign up.
COMPANY_EMAIL_DOMAINS=
# Google sign-in: the OAuth client ID from Google Cloud Console (public; used by the website and the backend).
# Authorised JavaScript origin there: https://<CG_DOMAIN>. Empty = no Google button.
GOOGLE_CLIENT_ID=

# ---- e-mail for sign-up / login codes (required: production never prints codes) -------------------------------------
# Gmail: an App Password (16 letters), not your normal password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- optional ------------------------------------------------------------------------------------------------------
# AI chat (without it the assistant gives its built-in backup answers)
GEMINI_API_KEY=
# Live threat-intelligence lookups used by the link detector and the Threat Intelligence page. Copy them from the
# laptop's backend\.env if you use them there, so the server gives the same verdicts (without them: models only).
VIRUSTOTAL_API_KEY=
URLHAUS_API_KEY=
ABUSEIPDB_API_KEY=
