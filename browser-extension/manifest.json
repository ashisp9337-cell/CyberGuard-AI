{
  "manifest_version": 3,
  "name": "CyberGuard AI - Safe Browsing",
  "short_name": "CyberGuard",
  "version": "1.0.0",
  "description": "Checks each website you open with your own CyberGuard AI on this computer and warns you before dangerous pages.",
  "permissions": ["storage", "webNavigation", "scripting"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "CyberGuard AI",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
  },
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "browser_specific_settings": {
    "gecko": {"id": "safe-browsing@cyberguard-threatora.local", "strict_min_version": "128.0"}
  }
}
