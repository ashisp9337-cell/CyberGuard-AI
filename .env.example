# Copy to .env. Defaults below work against the local backend started via
# `cd backend && uvicorn app.main:app --reload --port 8000`.

VITE_API_BASE_URL=http://localhost:8000
VITE_THREAT_INTELLIGENCE_API=
VITE_AUTH_SERVICE_URL=

# --- Authentication -------------------------------------------------------
# "backend" (default) talks to the real FastAPI backend above.
# "mock" uses the local, browser-only demo auth system — no backend needed.
VITE_AUTH_PROVIDER=backend

# Set true to use local mock data everywhere (offline UI development —
# no backend calls at all, including analysis scans).
VITE_USE_MOCK_DATA=false

# Google Identity Services client ID (public value, not a secret).
# Must match GOOGLE_CLIENT_ID in backend/.env for verification to succeed.
# Create one at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# Cloudflare Turnstile site key (public value, not a secret — the matching
# secret key stays server-side in backend/.env as TURNSTILE_SECRET_KEY).
# Create one at https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=
