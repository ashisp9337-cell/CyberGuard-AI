# ---- Environment ----
ENVIRONMENT=development   # development | production

# ---- Database ----
# Local dev (zero setup): sqlite:///./cyberguard.db
# Production: postgresql+psycopg2://user:password@host:5432/cyberguard
DATABASE_URL=sqlite:///./cyberguard.db

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false        # set true in production (HTTPS only)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TURNSTILE_SECRET_KEY=

# ---- Threat intelligence (optional — features degrade gracefully if unset) ----
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_API_KEY=

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173

# ---- Uploads / Reports ----
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports
MAX_UPLOAD_MB=15
