# ---- Environment ----
ENVIRONMENT=development   # development | production

# ---- Database: PostgreSQL only ----
# Create / upgrade the tables with:  alembic upgrade head
# Tests use a separate database with "_test" added to the name (cyberguard_test); they never touch this one.
DATABASE_URL=postgresql+psycopg2://cyberguard:your_db_password@localhost:5432/cyberguard

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false        # set true in production (HTTPS only)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TURNSTILE_SECRET_KEY=

# ---- Threat intelligence (optional — features degrade gracefully if unset) ----
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_API_KEY=

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173

# ---- Uploads / Reports ----
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports
MAX_UPLOAD_MB=15

# ---- Alerts (sent for threats scoring ALERT_MIN_SCORE or more) ----
ALERT_MIN_SCORE=71
# Findings of the background watchers (Gmail, Downloads, sign-ins): only this score or more sends an alert
# (Settings can switch it to "same level as my own scans"), and at most this many per hour.
AUTO_ALERT_MIN_SCORE=86
AUTO_ALERT_MAX_PER_HOUR=5
APP_BASE_URL=http://localhost:5173

# ---- Sign-in protection ----
# After this many wrong passwords for ONE account within LOGIN_LOCK_MINUTES, that account waits (whatever address
# the guesses come from). 0 = off.
LOGIN_MAX_FAILED_PER_ACCOUNT=10
LOGIN_LOCK_MINUTES=15

# ---- Automatic website protection (Settings -> Automatic Protection -> Your website's requests) ----
# Access logs of OTHER websites you run on this computer (nginx / Apache / IIS combined format), ';' between files.
# CyberGuard's own requests are always included. Example: WEBSITE_ACCESS_LOGS=C:\nginx\logs\access.log
WEBSITE_ACCESS_LOGS=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Forward a suspicious message or screenshot to your bot and it replies with the verdict (only TELEGRAM_CHAT_ID).
TELEGRAM_INBOX=true

# Email (Gmail: smtp.gmail.com + port 587 + a 16-letter App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# WhatsApp: callmebot (free, sends to your own number) or twilio
WHATSAPP_PROVIDER=callmebot
WHATSAPP_TO=
CALLMEBOT_APIKEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ---- Automatic protection (background watchers; on/off per watcher in Settings) ----
AUTOMATION_ENABLED=true
# CyberGuard account that receives automatic findings (empty = the first account)
AUTOMATION_USER_EMAIL=
# Gmail inbox watcher (read-only IMAP). Uses a Gmail App Password, NOT your normal password.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Gmail's Spam folder is checked too (phishing often lands there). off = inbox only
IMAP_SPAM_FOLDER=[Gmail]/Spam
EMAIL_POLL_SECONDS=60
EMAIL_BACKFILL=5
# Downloads folder watcher (empty = <your user folder>/Downloads)
DOWNLOADS_DIR=
DOWNLOADS_POLL_SECONDS=30
DOWNLOADS_MAX_MB=50
# Windows sign-in events (backend terminal must be "Run as administrator")
WINDOWS_EVENTS_POLL_SECONDS=300
# URL scans: safe read-only page fetch (false = never contact scanned sites)
LIVE_PAGE_CHECKS=true
