# ---- Environment ----
ENVIRONMENT=development   # development | production

# ---- Database ----
# Local dev (zero setup): sqlite:///./cyberguard.db
# Production: postgresql+psycopg2://user:password@host:5432/cyberguard
DATABASE_URL=postgresql+psycopg2://cyberguard:your_db_password@localhost:5432/cyberguard

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false        # set true in production (HTTPS only)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TURNSTILE_SECRET_KEY=

# ---- Threat intelligence (optional — features degrade gracefully if unset) ----
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_API_KEY=

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173

# ---- Uploads / Reports ----
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports
MAX_UPLOAD_MB=15

# ---- Alerts (sent for threats scoring ALERT_MIN_SCORE or more) ----
ALERT_MIN_SCORE=71
APP_BASE_URL=http://localhost:5173

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (Gmail: smtp.gmail.com + port 587 + a 16-letter App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# WhatsApp: callmebot (free, sends to your own number) or twilio
WHATSAPP_PROVIDER=callmebot
WHATSAPP_TO=
CALLMEBOT_APIKEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ---- Automatic protection (background watchers; on/off per watcher in Settings) ----
AUTOMATION_ENABLED=true
# CyberGuard account that receives automatic findings (empty = the first account)
AUTOMATION_USER_EMAIL=
# Gmail inbox watcher (read-only IMAP). Uses a Gmail App Password, NOT your normal password.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
EMAIL_POLL_SECONDS=60
EMAIL_BACKFILL=5
# Downloads folder watcher (empty = <your user folder>/Downloads)
DOWNLOADS_DIR=
DOWNLOADS_POLL_SECONDS=30
DOWNLOADS_MAX_MB=50
# Windows sign-in events (backend terminal must be "Run as administrator")
WINDOWS_EVENTS_POLL_SECONDS=300
# URL scans: safe read-only page fetch (false = never contact scanned sites)
LIVE_PAGE_CHECKS=true
